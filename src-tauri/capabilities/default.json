{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "vicons:default",
    "config-manager:default",
    "system-fonts:default",
    "network-manager:allow-get-network-state",
    "network-manager:allow-list-wifi-networks",
    "network-manager:allow-get-wireless-enabled",
    "network-manager:allow-set-wireless-enabled",
    "network-manager:allow-is-wireless-available",
    "network-manager:allow-connect-to-wifi",
    "network-manager:allow-get-network-stats",
    "network-manager:allow-get-network-interfaces",
    "network-manager:allow-list-vpn-profiles",
    "network-manager:allow-get-vpn-status",
    "network-manager:allow-connect-vpn",
    "network-manager:allow-disconnect-vpn",
    "network-manager:allow-create-vpn-profile",
    "network-manager:allow-update-vpn-profile",
    "network-manager:allow-delete-vpn-profile",
    "bluetooth-manager:allow-list-adapters",
    "bluetooth-manager:allow-list-devices",
    "bluetooth-manager:allow-set-adapter-powered",
    "bluetooth-manager:allow-bluetooth-plugin-status",
    "bluetooth-manager:allow-start-scan",
    "bluetooth-manager:allow-stop-scan",
    "bluetooth-manager:allow-connect-device",
    "bluetooth-manager:allow-get-device-info",
    "bluetooth-manager:allow-disconnect-device"
  ]
}
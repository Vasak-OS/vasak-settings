{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vasak-settings",
  "version": "0.2.6",
  "identifier": "ar.net.vasak.vasak-settings",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vasak-settings",
        "width": 980,
        "height": 670,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/usr/share/backgrounds/vasakos/**",
          "/usr/share/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "desktopTemplate": "vasak-settings.desktop.hbs",
        "depends": [
          "libcairo2",
          "desktop-file-utils",
          "libgdk-pixbuf-2.0-0",
          "libglib2.0-0t64",
          "libgtk-3-0t64",
          "hicolor-icon-theme",
          "libsoup2.4-1",
          "libsoup-3.0-0",
          "libpango-1.0-0",
          "libwebkit2gtk-4.1-0"
        ],
        "files": {}
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

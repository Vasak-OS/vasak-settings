{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vasak-settings",
  "version": "0.28.0",
  "identifier": "ar.net.vasak.vasak-settings",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vasak-settings",
        "width": 980,
        "height": 670,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://oauth2.googleapis.com https://www.googleapis.com; media-src 'self' asset: http://asset.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/usr/share/backgrounds/vasakos/**",
          "/usr/share/icons/**",
          "/var/lib/AccountsService/icons/**",
          "$CACHE/vasak/**",
          "$HOME/.cache/vasak/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "desktopTemplate": "vasak-settings.desktop.hbs",
        "depends": [
          "libc6",
          "libgcc-s1",
          "libcairo2",
          "libdbus-1-3",
          "libgdk-pixbuf-2.0-0",
          "libglib2.0-0t64",
          "libgtk-3-0t64",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0",
          "libwebkit2gtk-4.1-0",
          "dbus",
          "upower",
          "ffmpeg",
          "xdg-utils",
          "desktop-file-utils",
          "hicolor-icon-theme"
        ],
        "files": {}
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
